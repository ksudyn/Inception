server
{
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DOMAIN_NAME};

    # Certificados TLS (Docker secrets)
    ssl_certificate     /run/secrets/nginx_crt;
    ssl_certificate_key /run/secrets/nginx_key;

    # Protocolos TLS permitidos
    ssl_protocols TLSv1.2 TLSv1.3;

    # Preferir cifrados del servidor
    ssl_prefer_server_ciphers on;

    # Solo cifrados fuertes
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Cache de sesiones TLS (mejora rendimiento)
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    root /var/www/html;
    index index.php index.html index.htm;

    # WordPress routing
    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # Archivos estáticos (cacheados)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff2?)$ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Healthcheck para Docker
    location = /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # PHP-FPM (WordPress)
    location ~ \.php$ {
        include fastcgi.conf;
        fastcgi_pass wordpress:9000;
        fastcgi_index index.php;
    }

    # Bloquear archivos ocultos
    location ~ /\. {
        deny all;
    }
}
